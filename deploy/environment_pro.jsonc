// Custom Environment for the PRODUCTION workspaces.
// Same format as environment_dev.jsonc, where every option is documented.
{
  "environmentName": "pro_insidemicrosoftfabric_env_fabricutils",
  "folder": "Utils",
  "variableLibrary": {
    "name": "vl_environment",
    // Production activates the "pro" value set -> environment = "pro"
    "activeValueSet": "pro"
  },

  "runtimeVersion": "1.3",

  "sparkProperties": {
    "spark.native.enabled": "true",
    "spark.databricks.delta.autoCompact.enabled": "true",
    "spark.microsoft.delta.targetFileSize.adaptive.enabled": "true",
    "spark.microsoft.delta.optimize.fast.enabled": "true",
    "spark.microsoft.delta.optimize.fileLevelTarget.enabled": "true",
    "spark.databricks.delta.properties.defaults.enableDeletionVectors": "true",
    "spark.microsoft.delta.snapshot.driverMode.enabled": "true"
  },

  // Key = workspace name in workspaces_pro.json. {} = leave as is.
  "compute": {
    "pro_insidemicrosoftfabric_ws_control": {},
    "pro_insidemicrosoftfabric_ws_bronze": {},
    "pro_insidemicrosoftfabric_ws_silver": {
      "instancePool": {"name": "Starter Pool", "type": "Workspace"},
      "driverCores": 8,
      "driverMemory": "56g",
      "executorCores": 8,
      "executorMemory": "56g",
      "dynamicExecutorAllocation": {"enabled": true, "minExecutors": 1, "maxExecutors": 4}
    },
    "pro_insidemicrosoftfabric_ws_gold": {}
  }
}
