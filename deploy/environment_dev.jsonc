// Custom Environment for the DEV workspaces.
// Read by bootstrap_environments.py, deploy.py and migrate_runtime.py.
// Full-line '//' comments are allowed; the rest is strict JSON (watch the
// commas when you uncomment something: the last key of a block has none).
//
// Where each key shows up in Fabric, inside the Environment item:
//   runtimeVersion          -> "Runtime" selector
//   sparkProperties         -> Spark compute > Spark properties
//   compute.<workspace>     -> Spark compute > Compute
{
  // ------------------------------------------------------------------ //
  // ITEM NAMES -- created once by bootstrap_environments.py.
  // Naming convention: {env}_{company}_{item}_{descriptor}.
  // ------------------------------------------------------------------ //
  "environmentName": "dev_insidemicrosoftfabric_env_fabricutils",
  "folder": "Utils",
  "variableLibrary": {
    "name": "vl_environment",
    // Value set deploy.py activates in these workspaces. DEV uses the
    // default one ("Default value set" -> environment = "dev").
    "activeValueSet": "Default value set"
  },

  // ------------------------------------------------------------------ //
  // RUNTIME -- "1.3" (Spark 3.5, Delta 3.2, GA) or "2.0" (Spark 4, Delta 4, preview).
  // deploy.py only CHECKS it. To change it, edit it here and run
  // migrate_runtime.py (a direct change with the wheel published fails
  // with LibraryManagementError).
  // ------------------------------------------------------------------ //
  "runtimeVersion": "1.3",

  // ------------------------------------------------------------------ //
  // SPARK PROPERTIES -- applied when every session using this Environment
  // starts, so notebooks don't need spark.conf.set() for them.
  // This is the COMPLETE list: anything added by hand in the UI that is not
  // here gets removed on the next deploy. Values are always strings.
  //
  // Runtime 1.3: NEE + auto compaction + the Delta optimizations that
  //              Runtime 2.0 turns on by default (they're opt-in on 1.3).
  // Runtime 2.0: only NEE + auto compaction are still needed. See
  //              examples/environment_runtime_2_0.jsonc.
  //
  // Other common ones (check they exist on your runtime):
  //   "spark.fabric.resourceProfile": "writeHeavy"   (writeHeavy | readHeavyForSpark | readHeavyForPBI)
  //   "spark.sql.parquet.vorder.default": "true"     (V-Order, if Power BI Direct Lake reads the tables)
  //   "spark.databricks.delta.optimizeWrite.enabled": "true"
  //   "spark.sql.session.timeZone": "Europe/Madrid"
  // ------------------------------------------------------------------ //
  "sparkProperties": {
    // Native Execution Engine: OFF by default on 1.3 AND 2.0. Always set it.
    "spark.native.enabled": "true",
    // Auto compaction: not on by default on any runtime.
    "spark.databricks.delta.autoCompact.enabled": "true",
    // Default on 2.0, opt-in on 1.3:
    "spark.microsoft.delta.targetFileSize.adaptive.enabled": "true",
    "spark.microsoft.delta.optimize.fast.enabled": "true",
    "spark.microsoft.delta.optimize.fileLevelTarget.enabled": "true",
    "spark.databricks.delta.properties.defaults.enableDeletionVectors": "true",
    "spark.microsoft.delta.snapshot.driverMode.enabled": "true"
  },

  // ------------------------------------------------------------------ //
  // COMPUTE -- one entry per workspace (key = name in workspaces_dev.json).
  // {} = leave that workspace's compute as it is. Only the keys you set are
  // changed. Requires Workspace settings > Data Engineering/Science >
  // Spark settings > Pool > "Customize compute configurations for items" ON.
  //
  // Every option:
  //   "instancePool": {"name": "Starter Pool", "type": "Workspace"},   (type: Workspace | Capacity)
  //   "driverCores": 8,        (4 | 8 | 16 | 32 | 64)
  //   "driverMemory": "56g",   (pairs with cores: 4->28g, 8->56g, 16->112g, 32->224g, 64->400g)
  //   "executorCores": 8,
  //   "executorMemory": "56g",
  //   "dynamicExecutorAllocation": {"enabled": true, "minExecutors": 1, "maxExecutors": 4}
  //
  // Cores/memory can't exceed the pool's node size (Starter Pool = Medium
  // nodes, 8 cores / 56g). A custom pool must already exist in the workspace.
  // ------------------------------------------------------------------ //
  // Dev is sized small on purpose (4 cores / 28g, max 2 executors): it
  // runs on sample data and shouldn't burn capacity units. Production
  // (environment_pro.jsonc) is sized for the real volumes.
  "compute": {
    "dev_insidemicrosoftfabric_ws_control": {},
    "dev_insidemicrosoftfabric_ws_bronze": {},
    "dev_insidemicrosoftfabric_ws_silver": {
      "instancePool": {"name": "Starter Pool", "type": "Workspace"},
      "driverCores": 4,
      "driverMemory": "28g",
      "executorCores": 4,
      "executorMemory": "28g",
      "dynamicExecutorAllocation": {"enabled": true, "minExecutors": 1, "maxExecutors": 2}
    },
    "dev_insidemicrosoftfabric_ws_gold": {}
  }
}
